{
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "compression": "lzma"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "bundleVCRuntime": false
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": [
          "libc6 (>= 2.35)",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libglib2.0-0",
          "libdbus-1-3",
          "xdg-utils"
        ]
      }
    }
  },
  "build": {
    "windows": {
      "staticVCRuntime": true
    }
  }
}
