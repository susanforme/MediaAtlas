{
  "name": "mediaatlas",
  "version": "0.1.0-beta.8",
  "private": true,
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @mediaatlas/desktop tauri dev",
    "dev:web": "pnpm --filter @mediaatlas/desktop dev",
    "build": "pnpm --filter @mediaatlas/desktop build",
    "build:desktop": "pnpm --filter @mediaatlas/desktop tauri build --no-bundle",
    "typecheck": "pnpm --filter @mediaatlas/desktop typecheck",
    "test": "pnpm --filter @mediaatlas/desktop test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0"
  }
}
